<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NorthSky Live</title><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><style>
*{box-sizing:border-box}body{margin:0;background:#081624;color:#edf6ff;font:15px system-ui,-apple-system,sans-serif}header{background:#10283f;padding:17px 5%;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;border-bottom:1px solid #28465d}.logo{font-weight:900;font-size:26px}.logo span{color:#49c2fa}main{max-width:1250px;margin:auto;padding:18px}section{background:#11283d;border:1px solid #2b4a63;border-radius:18px;padding:20px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1.3fr 1fr;gap:16px}.hero{background:linear-gradient(110deg,#15528a,#10283f)}h1{margin:12px 0;font-size:34px}h2{font-size:19px;margin:0 0 16px}.temp{font-size:66px;font-weight:800}.muted{color:#9eb9d0;font-size:13px}button,input,select{background:#193a56;border:1px solid #42617a;color:white;padding:11px;border-radius:10px;font:inherit;min-width:0}button{cursor:pointer}button:hover{background:#275d86}.primary{background:#1975e8;border-color:#1975e8}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.row>*{flex:1}label{display:block;font-size:12px;color:#b3c9da;margin:12px 0 5px}input,select{width:100%}#map{height:350px;border-radius:12px;background:#183d55}.days{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.day{padding:12px 4px;text-align:center;background:#1a3a55;border-radius:10px;cursor:pointer}.day strong{display:block;font-size:20px;margin:10px 0}.alert{padding:12px;border-radius:9px;background:#57401d;color:#ffe3ac;margin:8px 0}.link{color:#7ed1ff}.chip{background:#24435c;border-radius:40px;padding:7px 12px;font-size:12px}.note{font-size:12px;color:#b4c8d8}@media(max-width:750px){.grid{grid-template-columns:1fr}.days{grid-template-columns:repeat(5,1fr)}h1{font-size:27px}.temp{font-size:54px}main{padding:10px}section{padding:15px}}
</style></head><body><header><div class="logo">◈ North<span>Sky</span> <small style="font-size:12px;color:#a9c6db">LIVE</small></div><div class="chip" id="status">Ready to load weather</div></header><main>
<section class="hero"><div class="row"><div><div class="chip" style="display:inline-block">CANADIAN WEATHER COMMAND CENTER</div><h1 id="cityTitle">Calgary, Alberta</h1><div id="desc">Choose Refresh for live weather</div></div><div><div class="temp"><span id="temp">--</span>°C</div><div>💨 <span id="windView">--</span> km/h &nbsp; 💧 <span id="humidView">--</span>%</div></div></div><p class="note" id="mode">Live forecast powered by Open-Meteo; manual override available.</p></section>
<div class="grid"><section><h2>🌧 Weather radar</h2><div id="map"></div><div class="row" style="margin-top:12px"><button id="radarRefresh">Refresh radar</button><button id="radarToggle">Hide radar</button></div><p class="note" id="radarStatus">RainViewer radar tiles. Internet connection required. Radar availability varies.</p></section>
<section><h2>🔎 Search & forecast controls</h2><label>Canadian city</label><input id="search" value="Calgary" placeholder="Search Canadian city"><button class="primary" id="load" style="margin-top:10px;width:100%">Refresh live forecast</button><hr style="border:0;border-top:1px solid #34546b;margin:20px 0"><h2>✎ Manual forecast override</h2><label>Temperature °C</label><input id="editTemp" type="number" value="12"><label>Conditions</label><select id="editCond"><option>Sunny</option><option>Partly cloudy</option><option>Cloudy</option><option>Rain</option><option>Snow</option><option>Thunderstorms</option></select><div class="row"><div><label>Wind km/h</label><input id="editWind" type="number" value="15"></div><div><label>Humidity %</label><input id="editHum" type="number" min="0" max="100" value="55"></div></div><div class="row" style="margin-top:12px"><button class="primary" id="override">Apply override</button><button id="restore">Restore live</button></div><p class="note">Overrides change the display only, not the weather provider.</p></section>
<section><h2>📅 10-day forecast</h2><div class="days" id="days"></div><p class="note">Tap a day to manually edit its forecast. Refreshing live data resets day edits.</p></section>
<section><h2>⚠ Official alerts & custom advisories</h2><p><a class="link" href="https://weather.gc.ca/" target="_blank" rel="noopener">View official Environment and Climate Change Canada alerts ↗</a></p><p class="note">Official alert status is not retrieved automatically in this version. Always use the government source for safety decisions.</p><div id="alerts"></div><label>Custom alert message</label><input id="alertText" placeholder="e.g. Thunderstorm watch"><div class="row" style="margin-top:10px"><button class="primary" id="add">Add custom alert</button><button id="clear">Clear</button></div></section></div><p class="note">Live data and radar require internet access and third-party services. Not an official warning service. NorthSky prototype.</p></main>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>
const $=x=>document.getElementById(x);let coords=[51.05,-114.07],map,radarLayer,radarOn=true,live=null,days=[],alerts=[];
const descriptions={0:'Clear sky',1:'Mainly clear',2:'Partly cloudy',3:'Cloudy',45:'Fog',48:'Fog',51:'Drizzle',53:'Drizzle',55:'Drizzle',61:'Rain',63:'Rain',65:'Heavy rain',71:'Snow',73:'Snow',75:'Heavy snow',80:'Rain showers',81:'Rain showers',82:'Heavy showers',95:'Thunderstorms',96:'Thunderstorms',99:'Thunderstorms'};
function cond(code){return descriptions[code]||'Variable conditions'}
function icon(s){return /thunder/i.test(s)?'⛈️':/snow/i.test(s)?'❄️':/rain|drizzle|shower/i.test(s)?'🌧️':/cloud/i.test(s)?'☁️':'☀️'}
function show(t,c,w,h){$('temp').textContent=Math.round(t);$('desc').textContent=icon(c)+' '+c;$('windView').textContent=Math.round(w);$('humidView').textContent=Math.round(h)}
function renderDays(){$('days').replaceChildren();days.forEach((d,i)=>{let b=document.createElement('button');b.className='day';b.innerHTML='<div>'+new Date(d.date+'T12:00:00').toLocaleDateString('en-CA',{weekday:'short',day:'numeric'})+'</div><strong>'+icon(d.cond)+'</strong><b>'+Math.round(d.max)+'°</b><div class="note">'+Math.round(d.min)+'° low</div>';b.onclick=()=>{let t=prompt('New high temperature (°C)',d.max);if(t===null||t.trim()===''||!Number.isFinite(Number(t)))return;let c=prompt('Condition',d.cond);if(c===null||!c.trim())return;d.max=Number(t);d.cond=c.trim();renderDays()};$('days').append(b)})}
async function load(){let q=$('search').value.trim();if(!q)return;$('status').textContent='Loading…';try{let g=await fetch('https://geocoding-api.open-meteo.com/v1/search?name='+encodeURIComponent(q)+'&count=20&language=en&format=json');if(!g.ok)throw Error('Geocoding unavailable');let gr=await g.json(),place=(gr.results||[]).find(x=>x.country_code==='CA');if(!place)throw Error('No Canadian city found');coords=[place.latitude,place.longitude];$('cityTitle').textContent=place.name+', '+(place.admin1||'Canada');let u='https://api.open-meteo.com/v1/forecast?latitude='+coords[0]+'&longitude='+coords[1]+'&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=10&timezone=auto';let r=await fetch(u);if(!r.ok)throw Error('Forecast service unavailable');let j=await r.json();live={t:j.current.temperature_2m,c:cond(j.current.weather_code),w:j.current.wind_speed_10m,h:j.current.relative_humidity_2m};days=j.daily.time.map((date,i)=>({date,max:j.daily.temperature_2m_max[i],min:j.daily.temperature_2m_min[i],cond:cond(j.daily.weather_code[i])}));renderDays();show(live.t,live.c,live.w,live.h);$('editTemp').value=live.t;$('editWind').value=live.w;$('editHum').value=live.h;$('mode').textContent='Live forecast • Updated '+new Date().toLocaleTimeString();$('status').textContent='● Live forecast loaded';if(map){map.setView(coords,7);refreshRadar()}}catch(e){$('status').textContent='Weather unavailable';$('mode').textContent=e.message+' — check internet connection and try again.'}}
$('load').onclick=load;$('restore').onclick=()=>{if(live){show(live.t,live.c,live.w,live.h);$('mode').textContent='Live weather restored'}else load()};$('override').onclick=()=>{let t=Number($('editTemp').value),w=Number($('editWind').value),h=Number($('editHum').value);if(!Number.isFinite(t)||!Number.isFinite(w)||w<0||h<0||h>100)return alert('Enter valid values');show(t,$('editCond').value,w,h);$('mode').textContent='MANUAL OVERRIDE • These values are user-entered'};
function renderAlerts(){$('alerts').replaceChildren();alerts.forEach((s,i)=>{let d=document.createElement('div');d.className='alert';d.textContent='CUSTOM • '+s+' ';let b=document.createElement('button');b.textContent='Remove';b.onclick=()=>{alerts.splice(i,1);renderAlerts()};d.append(b);$('alerts').append(d)})}
$('add').onclick=()=>{let s=$('alertText').value.trim();if(s){alerts.push(s);$('alertText').value='';renderAlerts()}};$('clear').onclick=()=>{alerts=[];renderAlerts()};
async function refreshRadar(){if(!map)return;$('radarStatus').textContent='Loading RainViewer radar…';try{let r=await fetch('https://api.rainviewer.com/public/weather-maps.json');if(!r.ok)throw Error('Radar API unavailable');let j=await r.json(),frames=j.radar&&j.radar.past;if(!frames||!frames.length)throw Error('No radar frames');let f=frames[frames.length-1];if(radarLayer)map.removeLayer(radarLayer);radarLayer=L.tileLayer('https://tilecache.rainviewer.com'+f.path+'/256/{z}/{x}/{y}/2/1_1.png',{opacity:.7,maxNativeZoom:7,attribution:'Radar © RainViewer'});if(radarOn)radarLayer.addTo(map);$('radarStatus').textContent='RainViewer radar • '+new Date(f.time*1000).toLocaleString()+' • Latest available frame'}catch(e){$('radarStatus').textContent='Radar unavailable: '+e.message}}
$('radarRefresh').onclick=refreshRadar;$('radarToggle').onclick=()=>{radarOn=!radarOn;$('radarToggle').textContent=radarOn?'Hide radar':'Show radar';if(radarLayer){if(radarOn)radarLayer.addTo(map);else map.removeLayer(radarLayer)}};
if(window.L){map=L.map('map').setView(coords,7);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors',maxZoom:18}).addTo(map);refreshRadar()}else $('radarStatus').textContent='Map library unavailable — internet required.';
load();
</script></body></html>
