<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#071629"><title>NorthSky | Canadian Weather</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" onerror="this.removeAttribute('integrity')">
<style>
:root{color-scheme:dark;--bg:#071629;--panel:#10243b;--line:#29435e;--ink:#edf6ff;--muted:#b0c4d8;--blue:#49b9ff}*{box-sizing:border-box}body{margin:0;background:linear-gradient(160deg,#071629,#0d2741);color:var(--ink);font:16px system-ui,-apple-system,sans-serif}button,input,select,textarea{font:inherit}button,.btn{background:#1766a4;border:1px solid #3a8cc5;color:white;border-radius:10px;padding:10px 13px;cursor:pointer;text-decoration:none}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #8bd5ff}button:disabled{opacity:.45;cursor:not-allowed}.secondary{background:#19314c}.top{position:sticky;top:0;z-index:1200;background:#091a2dec;border-bottom:1px solid var(--line);backdrop-filter:blur(10px)}.top-inner{max-width:1200px;margin:auto;padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.brand{font-size:24px;font-weight:800;letter-spacing:-.6px}.brand span{color:var(--blue)}nav{display:flex;gap:6px;flex-wrap:wrap}nav a{color:#e6f2ff;text-decoration:none;padding:9px 11px;border-radius:8px}nav a:hover{background:#214263}main{max-width:1200px;margin:auto;padding:24px 16px 65px}.hero{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:20px 0 25px}.eyebrow{color:#81d4ff;font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:12px}h1{font-size:clamp(30px,6vw,50px);line-height:1.08;margin:10px 0}h2{margin:0 0 14px;font-size:24px}p{line-height:1.5;color:var(--muted)}.card{background:#10243b;border:1px solid var(--line);border-radius:18px;padding:18px;margin:0 0 20px;box-shadow:0 8px 25px #0002}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.stat{padding:16px;background:#17314b;border-radius:12px}.stat b{display:block;font-size:21px;margin:8px 0}.toolbar{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin:10px 0 14px}.toolbar label{font-size:14px;color:var(--muted)}select,input,textarea{background:#091b2e;border:1px solid #46627e;border-radius:9px;padding:10px;color:white;max-width:100%}input[type=range]{padding:0;max-width:180px}#map{height:min(62vh,590px);min-height:350px;border-radius:12px;overflow:hidden;background:#1a3246}.leaflet-container{font-family:system-ui,sans-serif}.leaflet-control-attribution{font-size:10px!important}.legend{display:flex;align-items:center;flex-wrap:wrap;gap:6px;font-size:12px;color:#d6e8f7;margin-top:12px}.swatch{height:12px;width:23px;border-radius:2px}.note{font-size:13px;color:#bed2e4}.status{font-size:14px;color:#9ad9ff}.forecast-row{display:flex;gap:12px;justify-content:space-between;border-bottom:1px solid #29435e;padding:12px 0}.forecast-row:last-child{border:0}.forecast-row span:last-child{text-align:right}.hidden{display:none!important}.editor{display:grid;gap:12px;max-width:680px}.editor label{display:grid;gap:5px}.editor textarea{min-height:80px}.photo{width:100%;max-height:270px;object-fit:cover;border-radius:12px;margin-top:12px}.footer{color:#9eb5c9;font-size:13px;padding-top:20px}a{color:#91d5ff}@media(max-width:600px){nav{width:100%;justify-content:space-between}nav a{font-size:14px;padding:7px}#map{min-height:390px}.card{padding:13px}.toolbar{gap:7px}}
</style></head><body>
<header class="top"><div class="top-inner"><div class="brand">☁ North<span>Sky</span></div><nav aria-label="Main navigation"><a href="#home">Home</a><a href="#radar">Radar</a><a href="#forecast">Forecast</a><a href="#alerts">Alerts</a><a href="#customize">Customize</a></nav></div></header>
<main><section class="hero" id="home"><div><div class="eyebrow">Canadian weather dashboard</div><h1>Weather across Canada.<br>Clearly explained.</h1><p>Explore observed precipitation radar, publish your own forecast, and find official warnings.</p></div><div class="stat">🇨🇦 <strong>NorthSky</strong><br><small>Canada-wide coverage</small></div></section>
<section class="card" id="radar"><h2>🌧️ Canadian precipitation radar</h2><p>Observed radar from ECCC GeoMet. Use the slider to view available recent frames. Radar is not a future forecast.</p><div class="toolbar"><label for="radarType">Layer</label><select id="radarType"><option value="RADAR_1KM_RRAI">Observed rain / precipitation</option><option value="RADAR_1KM_RSNO">Observed snow</option></select><button id="play" type="button">▶ Play</button><button id="latest" class="secondary" type="button">Latest</button><button id="fullscreen" class="secondary" type="button">⛶ Full screen</button></div><div id="map" role="application" aria-label="Interactive Canadian radar map"></div><div class="toolbar"><label for="timeSlider">Past radar</label><input id="timeSlider" type="range" min="0" max="11" value="11" step="1"><strong id="timeLabel">Loading…</strong></div><div class="legend" id="legend"><span>Intensity (approximate display colours):</span><span class="swatch" style="background:#7de4ff"></span>Light <span class="swatch" style="background:#48d45b"></span>Moderate <span class="swatch" style="background:#e5e53b"></span>Heavy <span class="swatch" style="background:#ef5349"></span>Very heavy</div><p id="mapStatus" class="status" role="status">Preparing radar…</p><p class="note">Radar layer colour scales are defined by ECCC and can vary by product. Map frames are requested at 6-minute intervals; the service may not have every frame. GeoMet may be delayed or temporarily unavailable. Base map © OpenStreetMap contributors.</p><div class="grid"><div class="stat"><b>Future radar</b><p>Not enabled. Forecast radar requires a verified forecast-frame service; observed frames must not be presented as future predictions.</p></div><div class="stat"><b>Lightning observations</b><p>Live strike data is not connected. Use an official lightning information source until a licensed feed is configured.</p><a href="https://weather.gc.ca/lightning/index_e.html" target="_blank" rel="noopener">ECCC lightning information ↗</a></div></div></section>
<section class="card" id="forecast"><h2>☀️ NorthSky forecast</h2><p id="forecastIntro">Your own manually published forecast. Not an automatic official forecast.</p><div class="grid"><div class="stat"><small>Location</small><b id="displayLocation">Calgary, Alberta</b></div><div class="stat"><small>Conditions</small><b id="displayCondition">Forecast pending</b></div><div class="stat"><small>Temperature</small><b id="displayTemp">—</b></div></div><h3>10-day outlook</h3><div id="forecastList"></div></section>
<section class="card" id="alerts"><h2>⚠️ Weather alerts</h2><p>Check official ECCC weather alerts for current watches, warnings, and advisories. This page does not automatically ingest or display live warnings.</p><a class="btn" href="https://weather.gc.ca/?alertTableFilterProv=AB" target="_blank" rel="noopener">Open official Canadian weather alerts ↗</a></section>
<section class="card" id="customize"><h2>✏️ Customize your forecast</h2><p>Update the forecast on this device. Changes are saved in this browser only, not automatically published to everyone visiting your website.</p><div class="editor"><label>Location<input id="editLocation" placeholder="e.g. Calgary, Alberta"></label><label>Conditions<input id="editCondition" placeholder="e.g. Partly cloudy"></label><label>Temperature<input id="editTemp" placeholder="e.g. 8°C"></label><label>10-day outlook (one day per line)<textarea id="editDays" placeholder="Friday | Sunny | 9°C / 1°C"></textarea></label><label>Your weather picture (image URL)<input id="editPhoto" type="url" placeholder="https://example.com/storm.jpg"></label><label>Your weather icon (emoji or text)<input id="editIcon" placeholder="⛅"></label><div class="toolbar"><button id="save" type="button">Save my forecast</button><button id="reset" class="secondary" type="button">Reset demo</button></div><div id="saveStatus" role="status" class="status"></div><div id="customPhoto"></div></div><p class="note">To publish forecast changes to all visitors, update the default values in the HTML file and commit them on GitHub, or add a shared database/CMS later. For images, upload a file to your repository and use its relative path (such as images/storm.jpg), or use a direct image URL.</p></section>
<footer class="footer">NorthSky is an independent weather dashboard, not an official government warning service. Verify important weather decisions with Environment and Climate Change Canada.</footer></main>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
(()=>{'use strict';const $=id=>document.getElementById(id);const defaults={location:'Calgary, Alberta',condition:'Forecast pending',temp:'—',icon:'⛅',photo:'',days:['Day 1 | Update forecast | —','Day 2 | Update forecast | —','Day 3 | Update forecast | —','Day 4 | Update forecast | —','Day 5 | Update forecast | —','Day 6 | Update forecast | —','Day 7 | Update forecast | —','Day 8 | Update forecast | —','Day 9 | Update forecast | —','Day 10 | Update forecast | —']};let data;try{data={...defaults,...JSON.parse(localStorage.getItem('northsky-forecast')||'{}')}}catch{data={...defaults}};
function safeText(id,value){$(id).textContent=value||'—'}function render(){safeText('displayLocation',data.location);safeText('displayCondition',(data.icon||'')+' '+(data.condition||''));safeText('displayTemp',data.temp);const list=$('forecastList');list.replaceChildren();(data.days||[]).slice(0,10).forEach(line=>{const row=document.createElement('div');row.className='forecast-row';const parts=line.split('|').map(s=>s.trim());const a=document.createElement('strong');a.textContent=parts[0]||'Day';const b=document.createElement('span');b.textContent=parts.slice(1).join(' · ')||'Update forecast';row.append(a,b);list.append(row)});for(const [field,value] of Object.entries({editLocation:data.location,editCondition:data.condition,editTemp:data.temp,editIcon:data.icon,editPhoto:data.photo,editDays:(data.days||[]).join('\n')}))$(field).value=value||'';const box=$('customPhoto');box.replaceChildren();if(data.photo){const img=document.createElement('img');img.className='photo';img.alt='Custom NorthSky weather picture';img.src=data.photo;img.onerror=()=>{box.textContent='Picture could not be loaded. Check the image URL.'};box.append(img)}}render();$('save').onclick=()=>{data={location:$('editLocation').value.trim(),condition:$('editCondition').value.trim(),temp:$('editTemp').value.trim(),icon:$('editIcon').value.trim(),photo:$('editPhoto').value.trim(),days:$('editDays').value.split('\n').map(s=>s.trim()).filter(Boolean).slice(0,10)};try{localStorage.setItem('northsky-forecast',JSON.stringify(data));$('saveStatus').textContent='Saved on this device.'}catch{$('saveStatus').textContent='Could not save to browser storage.'}render()};$('reset').onclick=()=>{data={...defaults};localStorage.removeItem('northsky-forecast');render();$('saveStatus').textContent='Demo values restored.'};
if(!window.L){$('mapStatus').textContent='Map library could not load. Check your internet connection and reload.';return}const map=L.map('map',{zoomControl:true}).setView([56,-106],4);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'© OpenStreetMap contributors'}).addTo(map);let layer=null,timer=null,frame=11;const STEP=6*60*1000;const end=Math.floor((Date.now()-12*60*1000)/STEP)*STEP;const times=Array.from({length:12},(_,i)=>new Date(end-(11-i)*STEP));function timeString(d){return d.toLocaleString('en-CA',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'UTC',hour12:false})+' UTC'}function setRadar(){frame=Number($('timeSlider').value);const t=times[frame];$('timeLabel').textContent=timeString(t);const params={service:'WMS',request:'GetMap',version:'1.3.0',layers:$('radarType').value,styles:'',format:'image/png',transparent:true,time:t.toISOString().replace('.000Z','Z')};if(layer)map.removeLayer(layer);layer=L.tileLayer.wms('https://geo.weather.gc.ca/geomet?',{...params,opacity:.78,attribution:'Radar © ECCC',tileSize:256});let loaded=false;layer.on('load',()=>{loaded=true;$('mapStatus').textContent='Requested observed radar: '+timeString(t)+' (blank areas can mean no precipitation or unavailable frames).'});layer.on('tileerror',()=>{$('mapStatus').textContent='Some radar tiles failed to load. Try Latest or another time.'});layer.addTo(map);$('mapStatus').textContent='Loading observed radar for '+timeString(t)+'…';setTimeout(()=>{if(!loaded&&layer)$('mapStatus').textContent='Radar is taking longer than expected. Try Latest or reload.'},9000)}function stop(){if(timer){clearInterval(timer);timer=null}$('play').textContent='▶ Play'}$('timeSlider').oninput=()=>{stop();setRadar()};$('radarType').onchange=()=>{stop();setRadar()};$('latest').onclick=()=>{stop();$('timeSlider').value=11;setRadar()};$('play').onclick=()=>{if(timer){stop();return}$('play').textContent='⏸ Pause';timer=setInterval(()=>{$('timeSlider').value=(Number($('timeSlider').value)+1)%12;setRadar()},1500)};$('fullscreen').onclick=()=>{const el=$('map');if(document.fullscreenElement){document.exitFullscreen?.()}else if(el.requestFullscreen){el.requestFullscreen().catch(()=>{$('mapStatus').textContent='Full screen is not supported by this browser.'})}else{$('mapStatus').textContent='Full screen is not supported on this iPhone browser.'}};document.addEventListener('fullscreenchange',()=>setTimeout(()=>map.invalidateSize(),250));setRadar();})();
</script></body></html>
